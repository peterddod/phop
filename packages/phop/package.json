{
  "name": "@peterddod/phop",
  "version": "1.10.3",
  "description": "Peer-to-peer state management for React using WebRTC. Share and sync state across browsers in real time — no backend required.",
  "keywords": [
    "react",
    "p2p",
    "webrtc",
    "peer-to-peer"
  ],
  "license": "MIT",
  "author": "Peter Dodd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterddod/phop.git"
  },
  "homepage": "https://github.com/peterddod/phop#readme",
  "bugs": {
    "url": "https://github.com/peterddod/phop/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.mjs",
      "require": "./dist/worker.js",
      "default": "./dist/worker.mjs"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsup src/index.ts src/worker.ts --format cjs,esm --sourcemap --clean && tsc -p tsconfig.build.json",
    "dev": "tsup src/index.ts src/worker.ts --format cjs,esm --sourcemap --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.9",
    "jsdom": "^30.1.2",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
