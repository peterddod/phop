{
  "name": "signalling-server",
  "version": "1.10.2",
  "description": "WebRTC signalling server for react-p2p",
  "license": "MIT",
  "author": "Peter Dodd",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --sourcemap --clean && tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "tsup src/index.ts --format cjs --sourcemap --watch --onSuccess \"node dist/index.js\"",
    "start": "node dist/index.js",
    "test": "tsup src/index.ts --format cjs --clean && node --test test/server.test.mjs"
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.5.9",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2"
  }
}
